{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UserStateSnapshot",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:423575705842:table/OghamUserState"
    },
    {
      "Sid": "PerUserCaptures",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:423575705842:table/OghamCaptures"
    }
  ]
}
